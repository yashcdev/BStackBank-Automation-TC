{
  "name": "bstackbank-automation",
  "version": "1.0.0",
  "description": "BStackBank Mobile Automation - WebdriverIO + Appium + Cucumber BDD",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:android": "PLATFORM=android wdio run wdio.conf.js",
    "test:ios": "PLATFORM=ios wdio run wdio.conf.js",
    "test:smoke": "wdio run wdio.conf.js --cucumberOpts.tagExpression='@smoke'",
    "test:regression": "wdio run wdio.conf.js --cucumberOpts.tagExpression='@regression'",
    "test:login": "wdio run wdio.conf.js --cucumberOpts.tagExpression='@login'",
    "test:transfer": "wdio run wdio.conf.js --cucumberOpts.tagExpression='@transfer'",
    "test:transactions": "wdio run wdio.conf.js --cucumberOpts.tagExpression='@transactions'",
    "test:qrscan": "PLATFORM=androidPixel wdio run wdio.conf.js --cucumberOpts.tagExpression='@qrscan'",
    "test:pixel": "PLATFORM=androidPixel wdio run wdio.conf.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@wdio/browserstack-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/cucumber-framework": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.0.0",
    "dotenv": "^16.0.0"
  }
}
